{
  "expo": {
    "name": "Musicly",
    "slug": "Musicly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "musicly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.captnoah.Musicly",
      "deploymentTarget": "16.2",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.captnoah.Musicly"
        ]
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "UISupportsDocumentBrowser": true,
        "NSPhotoLibraryUsageDescription": "Musicly needs access to your photo library to save your Wrap card.",
        "NSPhotoLibraryAddUsageDescription": "Musicly needs permission to save your Wrap card to your Photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1410",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.captnoah.Musicly",
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#0E1410",
          "dark": {
            "backgroundColor": "#0E1410"
          }
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-background-task",
      [
        "expo-widgets",
        {
          "enablePushNotifications": false,
          "groupIdentifier": "group.com.captnoah.Musicly",
          "bundleIdentifier": "com.captnoah.Musicly.widgets",
          "widgets": [
            {
              "name": "SyncWidget",
              "src": "./widgets/SyncWidget.jsx",
              "displayName": "Sync Progress",
              "description": "Track your music downloads",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
